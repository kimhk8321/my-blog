# 이 파일을 .env.local 로 복사하고 값을 채우세요. (배포 호스트에도 동일하게 설정)

# ── 배포 도메인 (SEO) ───────────────────────────────────
# 없으면 http://localhost:3000 으로 폴백 → sitemap·canonical·OG URL이
# 전부 localhost가 되어 검색엔진 색인 불가. 배포 시 반드시 실제 도메인으로.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── 조회수 저장소 (Upstash Redis) ───────────────────────
# https://upstash.com 에서 무료 Redis DB 생성 → REST URL/TOKEN 복사.
# 미설정 시 조회수 기능은 자동으로 비활성화(숨김)됩니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
